{
  "name": "shotwise",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test:e2e": "playwright test",
    "shots:showcase": "node scripts/screenshot-showcase.mjs",
    "shots:gapping": "tsx scripts/screenshot-gapping.ts",
    "test:db": "node scripts/test-db.mjs",
    "verify:csv": "tsx scripts/verify-csv.ts",
    "verify:unusual": "tsx scripts/verify-unusual-shots.ts",
    "verify:classifier": "tsx scripts/verify-classifier.ts",
    "verify:performance": "tsx scripts/verify-performance.ts",
    "verify:realworld": "tsx scripts/verify-realworld.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.73.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
